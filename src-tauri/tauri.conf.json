{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Voice",
  "version": "0.1.0",
  "identifier": "dev.lucasstrondinha.hermes-voice",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Hermes Voice",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}